{
    "name": "mayoui-react",
    "version": "1.2.0",
    "description": "React UI 컴포넌트 라이브러리",
    "keywords": [
        "react",
        "mayoui",
        "typescript",
        "ui",
        "component-library",
        "design-system",
        "korean",
        "dark-mode",
        "chart",
        "avatar",
        "button",
        "dialog",
        "toast",
        "sidebar",
        "tabs",
        "tooltip"
    ],
    "license": "MIT",
    "author": "creamnayeon",
    "repository": {
        "type": "git",
        "url": "https://github.com/Andaemin/mayoui"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "style": "./dist/index.css",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./styles": "./dist/index.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "jsdom": "^29.0.2",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.0.4",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.1.4"
    },
    "dependencies": {
        "react-icons": "^5.7.0"
    }
}
